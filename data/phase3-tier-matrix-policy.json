{
  "version": "1.0.0",
  "status": "phase-3-report-only",
  "mode": "report-only",
  "purpose": "Define cumulative fields, sections, tools, downloads and delivery rights for every Phase 3 content item without changing evidence status or enforcing access.",
  "exitCondition": "Every important item has a deterministic tier matrix, required public safety surface, minimum entitlement, delivery decision and download decision; higher tiers are cumulative and never change factual status.",
  "tierOrder": [
    "public",
    "registered",
    "supporter_3",
    "intelligence_6",
    "research_pro_9"
  ],
  "accessClassMinimumTier": {
    "public_core": "public",
    "public_preview": "public",
    "registered_private": "registered",
    "supporter_private": "supporter_3",
    "intelligence_private": "intelligence_6",
    "research_pro_private": "research_pro_9"
  },
  "viewStates": [
    "full",
    "preview",
    "metadata_only",
    "commercial_landing",
    "access_denied",
    "internal_only",
    "restricted_review"
