    .money-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1rem}.money-card{border:1px solid rgba(216,181,106,.3);border-radius:22px;padding:1.2rem;background:linear-gradient(150deg,rgba(14,8,2,.97),rgba(0,0,0,.96));box-shadow:0 18px 55px rgba(0,0,0,.28)}.membership-tier{display:flex;flex-direction:column;min-height:100%}.membership-tier h3{font-size:1.55rem;margin:.7rem 0 .2rem}.membership-tier h4{margin:1rem 0 .45rem;color:#d8b56a}.price{display:flex;align-items:baseline;gap:.35rem;color:#d8b56a;font-weight:900;flex-wrap:wrap}.price span{font-size:2.7rem}.price small{font-size:.9rem;color:#c8b98c}.tier-top{display:flex;justify-content:space-between;gap:.6rem;align-items:center;flex-wrap:wrap}.tier-code{font-size:.78rem;color:#c8b98c}.tier-includes{border-left:3px solid #d8b56a;padding:.55rem .75rem;background:rgba(216,181,106,.07)}.tier-benefits{padding-left:1.25rem;display:grid;gap:.45rem}.tier-access{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1rem}.tier-access span{border:1px solid rgba(216,181,106,.28);border-radius:999px;padding:.3rem .58rem;font-size:.75rem;color:#eadcae}.tier-boundary{font-size:.84rem;color:#c8b98c;border-left:3px solid rgba(216,181,106,.55);padding-left:.75rem}.membership-status{border:1px solid rgba(216,181,106,.38);background:rgba(216,181,106,.08);border-radius:14px;padding:1rem;margin:1rem 0}.membership-status.good{border-color:#376b37;color:#b7ecb7}.membership-status.warning{border-color:#8a6a22;color:#ead49e}.membership-status.danger{border-color:#844;color:#ffb0a8}.membership-table-wrap{overflow:auto;border:1px solid rgba(216,181,106,.25);border-radius:16px}.membership-comparison table{border-collapse:collapse;width:100%;min-width:840px;background:rgba(5,5,5,.78)}.membership-comparison th,.membership-comparison td{padding:.8rem;border-bottom:1px solid rgba(216,181,106,.16);text-align:center}.membership-comparison th:first-child{text-align:left}.membership-comparison thead th{color:#d8b56a;background:#0d0a05;position:sticky;top:0}.email-capture{display:flex;gap:.5rem;flex-wrap:wrap}.email-capture input{min-width:220px;flex:1;background:#050505;color:#f3e6bd;border:1px solid rgba(216,181,106,.35);border-radius:12px;padding:.75rem}.form-status{width:100%;font-size:.82rem;color:#c8b98c}.paypal-slot{min-height:44px;margin-top:auto;padding-top:12px}.free-tier-action{margin-top:auto;padding-top:12px}.login-required{margin-top:8px}.evidence-promise,.checkout-consent{border:1px solid rgba(216,181,106,.45);background:linear-gradient(145deg,rgba(216,181,106,.12),rgba(0,0,0,.78));border-radius:20px;padding:1.25rem}.evidence-promise strong,.checkout-consent strong{color:#f0d893}.consent-list{display:grid;gap:.8rem;margin:1rem 0}.consent-list label{display:grid;grid-template-columns:auto 1fr;gap:.7rem;align-items:start}.consent-list input{margin-top:.25rem;transform:scale(1.15)}.legal-links{display:flex;gap:.7rem;flex-wrap:wrap}.commercial-boundary{border-left:4px solid #d8b56a;padding:.8rem 1rem;background:rgba(216,181,106,.07)}@media(max-width:700px){.money-grid{grid-template-columns:1fr}.price span{font-size:2.3rem}}
