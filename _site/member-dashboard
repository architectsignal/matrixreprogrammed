<script>
(() => {
  const status = document.getElementById('dashboard-status');
  const loggedOut = document.getElementById('logged-out');
  const content = document.getElementById('dashboard-content');
  const cancelButton = document.getElementById('cancel-subscription');
  const actionStatus = document.getElementById('paypal-action-status');
  let currentSubscription = null;
  const titleCase = value => String(value || '').replace(/_/g,' ').replace(/\b\w/g, letter => letter.toUpperCase());
  const showLoggedOut = message => {
    status.textContent = message || 'Sign-in required.';
    loggedOut.classList.remove('hidden');
    content.classList.add('hidden');
  };
  const renderAccess = paid => {
    const list = document.getElementById('access-list');
    const free = ['free member account','Daily Control Brief signup','secure email sign-in'];
    const paidItems = ['premium membership active','premium briefs and member-only releases','premium member content'];
    list.innerHTML = [...free,...(paid?paidItems:[])].map(item => '<li>'+item+'</li>').join('');
  };
  const renderSubscription = data => {
    const subscription = data.subscription || null;
    currentSubscription = subscription;
    const paid = data.paidAccessEnabled === true;
    document.getElementById('paid-access').textContent = paid ? 'Active' : 'Not active';
    document.getElementById('paid-access').className = paid ? 'good' : 'warning';
    if (!subscription) {
      document.getElementById('paypal-status').textContent = data.paypalConfigured ? 'No paid subscription' : 'Paid memberships coming soon';
      document.getElementById('paypal-tier').textContent = 'Free';
      document.getElementById('paypal-next-billing').textContent = '—';
      document.getElementById('paypal-reference').textContent = '';
      cancelButton.classList.add('hidden');
      renderAccess(false);
      return;
    }
    const subStatus = String(subscription.status || 'UNKNOWN').toUpperCase();
    document.getElementById('paypal-status').textContent = titleCase(subStatus);
    document.getElementById('paypal-status').className = 'value ' + (subStatus === 'ACTIVE' ? 'good' : ['CANCELLED','EXPIRED','SUSPENDED'].includes(subStatus) ? 'danger' : 'warning');
    document.getElementById('paypal-tier').textContent = titleCase(subscription.tier || 'free');
    document.getElementById('paypal-next-billing').textContent = subscription.next_billing_at ? new Date(subscription.next_billing_at).toLocaleString() : 'Not available';
    document.getElementById('paypal-reference').textContent = subscription.provider_subscription_id ? 'PayPal reference: ' + subscription.provider_subscription_id : '';
    if (!['CANCELLED','EXPIRED'].includes(subStatus)) cancelButton.classList.remove('hidden'); else cancelButton.classList.add('hidden');
    renderAccess(paid);
  };
  const load = async () => {
    try {
      const response = await fetch('/api/member/me', {headers:{accept:'application/json'}, cache:'no-store'});
      const data = await response.json();
      if (!response.ok || !data.authenticated) return showLoggedOut('Please sign in to continue.');
      const member = data.member || {};
      document.getElementById('member-name').textContent = member.displayName || 'Matrix Member';
      document.getElementById('member-email').textContent = member.email || '';
      document.getElementById('member-verified').textContent = member.emailVerifiedAt ? 'Yes' : 'No';
      document.getElementById('member-tier').textContent = titleCase(member.tier || 'free');
      document.getElementById('member-status').textContent = member.status || 'unknown';
      document.getElementById('marketing-status').textContent = member.marketingStatus || 'unknown';
      const query = new URLSearchParams(location.search);
      status.textContent = query.has('verified') ? 'Email verified. Your member account is active.' : query.get('paypal') === 'active' ? 'PayPal membership verified and active.' : 'You are signed in.';
      renderSubscription(data);
      content.classList.remove('hidden');
      loggedOut.classList.add('hidden');
    } catch (error) {
      showLoggedOut('We could not sign you in. Please try again.');
    }
  };
  cancelButton.addEventListener('click', async () => {
    if (!currentSubscription || !confirm('Cancel this PayPal membership? Paid access will be removed when the cancellation is confirmed.')) return;
    cancelButton.disabled = true;
    actionStatus.className = 'status warning';
    actionStatus.textContent = 'Cancelling the subscription with PayPal…';
    try {
      const response = await fetch('/api/paypal/subscription/cancel', {method:'POST',headers:{accept:'application/json'}});
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.error || 'Cancellation failed.');
      actionStatus.className = 'status good';
      actionStatus.textContent = 'PayPal membership cancelled. Refreshing your access…';
      setTimeout(load, 700);
    } catch (error) {
      actionStatus.className = 'status danger';
      actionStatus.textContent = error.message || 'Cancellation failed.';
    } finally {
      cancelButton.disabled = false;
    }
  });
  document.getElementById('logout-button').addEventListener('click', async () => {
    await fetch('/api/auth/logout', {method:'POST', headers:{accept:'application/json'}}).catch(()=>null);
    location.href = '/member-login.html';
  });
  load();
})();
</script>
