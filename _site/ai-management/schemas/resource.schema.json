{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrixreprogrammed.com/schemas/ai-management/resource.schema.json",
  "title": "Matrix Reprogrammed Resource Registry record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "resource_id", "provider_name", "service_name", "capability_types", "resource_tier",
    "approved_for_automation", "approved_data_classes", "prohibited_data_classes",
    "billing_enabled", "billing_risk", "payment_method_present", "quota_verified",
    "quality_score", "reliability_score", "latency_score", "privacy_score",
    "provenance_score", "quota_efficiency_score", "supported_job_types",
    "implementation_status", "adapter_version", "enabled", "manual_approval_required",
    "created_at", "updated_at"
  ],
  "properties": {
    "resource_id": { "type": "string", "minLength": 3, "maxLength": 180 },
    "provider_name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "service_name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "capability_types": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "resource_tier": { "enum": [0, 1, 2, 3, 4] },
    "official_documentation_url": { "type": ["string", "null"], "format": "uri" },
    "terms_url": { "type": ["string", "null"], "format": "uri" },
    "privacy_url": { "type": ["string", "null"], "format": "uri" },
    "status_url": { "type": ["string", "null"], "format": "uri" },
    "licence": { "type": ["string", "null"] },
    "account_owner": { "type": ["string", "null"] },
    "authentication_type": { "enum": ["none", "environment_secret", "managed_identity", "manual"] },
    "credential_reference": { "type": ["string", "null"], "description": "A secret binding name only; never a credential value." },
    "approved_for_automation": { "type": "boolean" },
    "approved_data_classes": { "type": "array", "items": { "enum": ["public", "internal", "confidential", "restricted"] }, "uniqueItems": true },
    "prohibited_data_classes": { "type": "array", "items": { "enum": ["public", "internal", "confidential", "restricted"] }, "uniqueItems": true },
    "free_quota_amount": { "type": ["number", "null"], "minimum": 0 },
    "free_quota_unit": { "type": ["string", "null"] },
    "quota_reset_period": { "type": ["string", "null"] },
    "quota_reset_time": { "type": ["string", "null"] },
    "quota_remaining": { "type": ["number", "null"], "minimum": 0 },
    "quota_reserved": { "type": "number", "minimum": 0 },
    "hard_stop_threshold": { "type": "number", "minimum": 0 },
    "quota_verified": { "type": "boolean" },
    "quota_unlimited": { "type": "boolean" },
    "billing_enabled": { "const": false },
    "billing_risk": { "enum": ["none", "low", "medium", "high", "unknown"] },
    "payment_method_present": { "const": false },
    "monetary_cost_per_unit_eur": { "const": 0 },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "reliability_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "latency_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "privacy_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "provenance_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "quota_efficiency_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "last_health_check": { "type": ["string", "null"], "format": "date-time" },
    "health_status": { "enum": ["healthy", "degraded", "unknown", "unhealthy", "cooldown"] },
    "last_terms_check": { "type": ["string", "null"], "format": "date-time" },
    "terms_revalidation_due": { "type": ["string", "null"], "format": "date-time" },
    "last_quota_check": { "type": ["string", "null"], "format": "date-time" },
    "last_success": { "type": ["string", "null"], "format": "date-time" },
    "last_failure": { "type": ["string", "null"], "format": "date-time" },
    "consecutive_failures": { "type": "integer", "minimum": 0 },
    "cooldown_until": { "type": ["string", "null"], "format": "date-time" },
    "average_latency": { "type": "number", "minimum": 0 },
    "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "supported_job_types": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "maximum_payload": { "type": "integer", "minimum": 0 },
    "rate_limit": { "type": ["string", "null"] },
    "concurrency_limit": { "type": "integer", "minimum": 1 },
    "fallback_resource_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "implementation_status": { "enum": ["production", "batch", "experimental", "manual_export", "disabled"] },
    "adapter_id": { "type": "string" },
    "adapter_version": { "type": "string" },
    "enabled": { "type": "boolean" },
    "manual_approval_required": { "type": "boolean" },
    "allowed_hosts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "notes": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
