{
  "version": "1.0.0",
  "status": "phase-3-report-only",
  "mode": "simulation-only",
  "purpose": "Define deterministic access decisions for Phase 3 sections and delivery channels without activating authentication, entitlements or payment.",
  "exitCondition": "Every item has a fail-closed decision for anonymous, registered, member, expired, product-purchase, internal-review, restricted-review and unknown access contexts.",
  "membershipOrder": ["public", "registered", "supporter_3", "intelligence_6", "research_pro_9"],
  "accessContexts": {
    "anonymous": {"tier": "public", "status": "none", "roles": [], "product": "none"},
    "registered": {"tier": "registered", "status": "active", "roles": [], "product": "none"},
    "supporter": {"tier": "supporter_3", "status": "active", "roles": [], "product": "none"},
    "intelligence_member": {"tier": "intelligence_6", "status": "active", "roles": [], "product": "none"},
    "research_pro": {"tier": "research_pro_9", "status": "active", "roles": [], "product": "none"},
    "expired_member": {"tier": "research_pro_9", "status": "expired", "fallbackTier": "registered", "roles": [], "product": "none"},
    "matching_product_purchase": {"tier": "registered", "status": "active", "roles": [], "product": "matching"},
    "nonmatching_product_purchase": {"tier": "registered", "status": "active", "roles": [], "product": "nonmatching"},
    "operations_reviewer": {"tier": "registered", "status": "active", "roles": ["operations_reviewer"], "product": "none"},
    "sensitive_content_reviewer": {"tier": "registered", "status": "active", "roles": ["sensitive_content_reviewer"], "product": "none"},
    "unknown": {"tier": null, "status": "unknown", "roles": [], "product": "unknown"}
  },
  "channels": [
    "page",
    "section",
    "public_search",
    "feed",
    "email",
    "dashboard",
    "download",
    "api",
    "source_markup",
    "embedded_data"
  ],
  "decisions": [
    "allow_full",
    "allow_public_preview",
    "allow_metadata",
    "allow_product_page",
    "allow_product_file",
    "allow_operations",
    "allow_sensitive_review",
    "deny_login",
    "deny_upgrade",
    "deny_purchase",
    "deny_operations",
    "deny_sensitive",
    "deny_inactive",
    "deny_channel",
    "deny_unknown"
  ],
  "rules": {
    "unknownFailsClosed": true,
    "inactivePaidMembershipFallsBackToRegistered": true,
    "paidItemWithoutEntitlementShowsPublicPreview": true,
    "registeredItemWithoutAccountRequiresLogin": true,
    "separateProductRequiresMatchingPurchaseForFiles": true,
    "membershipDoesNotGrantProductFiles": true,
    "membershipDoesNotGrantOperationsAccess": true,
    "membershipDoesNotGrantSensitiveReviewAccess": true,
    "operationsRoleDoesNotGrantMembershipDepth": true,
    "sensitiveReviewRoleDoesNotGrantMembershipDepth": true,
    "publicSearchUsesPublicProjectionOnly": true,
    "sourceMarkupUsesPublicProjectionOnly": true,
    "embeddedDataUsesPublicProjectionOnly": true,
    "downloadsRequireFullAccessAndDeclaredDownload": true,
    "apiRequiresFullAccessAndTierApiPermission": true,
    "emailAndDashboardRequireActiveEntitlement": true,
    "publicPreviewRetainsAllSafetySections": true,
    "factualStatusNeverChangesByAccessContext": true
  },
  "protectedBoundaries": {
    "enforcement": false,
    "authentication": false,
    "entitlements": false,
    "emailDelivery": false,
    "payment": false,
    "routeMovement": false,
    "searchMutation": false,
    "contentMutation": false
  }
}
