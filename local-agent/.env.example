# Required: generate a unique random value of at least 32 characters.
MATRIX_LOCAL_AGENT_SHARED_SECRET=

# Required only when registering this machine with the live control plane.
MATRIX_AI_MANAGEMENT_ADMIN_TOKEN=
MATRIX_SITE_URL=https://matrixreprogrammed.com

# Secure defaults: loopback-only local server.
MATRIX_LOCAL_AGENT_HOST=127.0.0.1
MATRIX_LOCAL_AGENT_PORT=43117
MATRIX_LOCAL_AGENT_ALLOW_LAN=false
MATRIX_LOCAL_AGENT_REGISTRATION_SECONDS=300
MATRIX_LOCAL_AGENT_MAX_BODY_BYTES=262144
MATRIX_LOCAL_AGENT_MAX_CLOCK_SKEW_SECONDS=120

# Host load protection. Local jobs pause below either free-memory floor;
# benchmarks require the additional reserve. Busy work is deferred, not lost.
MATRIX_LOCAL_MIN_FREE_MEMORY_MB=4096
MATRIX_LOCAL_MIN_FREE_MEMORY_PERCENT=25
MATRIX_LOCAL_BENCHMARK_RESERVE_MB=1024
MATRIX_LOCAL_BUSY_BACKOFF_SECONDS=60

# Optional local Ollama model. No prompt is sent to Cloudflare.
MATRIX_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434
MATRIX_LOCAL_MODEL_PROTOCOL=ollama
MATRIX_LOCAL_MODEL_ID=
MATRIX_LOCAL_MODEL_CONTEXT_LENGTH=32768
MATRIX_LOCAL_MODEL_PARAMETERS_BILLION=0
MATRIX_LOCAL_MODEL_ESTIMATED_VRAM_GB=0
MATRIX_LOCAL_AGENT_ALLOW_LLM_JOBS=false
