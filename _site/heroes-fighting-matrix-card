const suits={KEYS:{icon:'⌘',name:'Keys',color:'#61d6b4',pale:'#d7fff4'},SHIELDS:{icon:'⬡',name:'Shields',color:'#63aee8',pale:'#d6edff'},TORCHES:{icon:'✦',name:'Torches',color:'#e5a84f',pale:'#ffe4b3'},SWORDS:{icon:'⚔',name:'Swords',color:'#d85d62',pale:'#ffd5d7'}};
