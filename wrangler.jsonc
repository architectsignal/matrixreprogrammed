{
  // Recovery mirror of the canonical wrangler.toml used by production workflows.
  // Keep runtime-affecting values in semantic parity with that file.
  "name": "matrixreprogrammed",
  "main": "src/worker-production-autonomy.js",
  "compatibility_date": "2026-06-25",

  // Runtime credentials and activation switches are managed in Cloudflare.
  // Preserve dashboard values across every Wrangler deployment.
  "keep_vars": true,

  "routes": [
    {
      "pattern": "matrixreprogrammed.com/*",
      "zone_name": "matrixreprogrammed.com"
    },
    {
      "pattern": "www.matrixreprogrammed.com/*",
      "zone_name": "matrixreprogrammed.com"
    }
  ],
  "triggers": {
    "crons": ["5 6 * * *", "15 7 * * 1", "35 * * * *"]
  },
  "vars": {
    "EMAIL_AUTOMATION_ENABLED": "true",
    "EMAIL_TRANSACTIONAL_ENABLED": "true",
    "BREVO_DOMAIN_AUTHENTICATED": "true",
    "EMAIL_RETRY_QUARANTINE_BEFORE": "2026-07-18T00:00:00.000Z",
    "INTELLIGENCE_REPORT_BATCH_LIMIT": "100",
    "MEMBERS_FROM_EMAIL": "members@matrixreprogrammed.com",
    "MEMBERS_FROM_NAME": "Matrix Reprogrammed",
    "MEMBERS_REPLY_TO_EMAIL": "njmgroupfrance@gmail.com",
    "MEMBERS_REPLY_TO_NAME": "Matrix Reprogrammed Support",
    "ENABLE_KV_COMPATIBILITY_MIRROR": "false",

    "AI_RESOURCE_BROKER_ENABLED": "false",
    "AI_RESOURCE_EXTERNAL_ENABLED": "false",
    "AI_RESOURCE_LOCAL_ONLY": "true",
    "AI_RESOURCE_ZERO_SPEND_LOCK": "true",
    "AI_RESOURCE_BACKGROUND_ENABLED": "false",
    "AI_RESOURCE_SCOUT_ENABLED": "false",
    "AI_RESOURCE_AUTO_APPROVAL_ENABLED": "false",
    "AI_LOCAL_MODEL_ROUTING_ENABLED": "false",
    "AI_SITE_DIRECTOR_ENABLED": "false",
    "AI_OPPORTUNITY_HUNTER_ENABLED": "false"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./_site",
    "run_worker_first": [
      "/api/*",
      "/.netlify/functions/*",
      "/newsletter-signup",
      "/subscribe-newsletter",
      "/forum-*",
      "/submit-*",
      "/report-*",
      "/admin-control-center*",
      "/review-dashboard*",
      "/source-intake*",
      "/deploy-status*",
      "/deploy-health*",
      "/card-system-health*",
      "/site-brain-router*",
      "/card-artwork-automation*",
      "/card-artwork-queue*",
      "/card-artwork-batches*",
      "/card-art-studio*",
      "/conclusion-engine*",
      "/information-gathering-system*",
      "/update-monitor*",
      "/distribution-center*",
      "/launch-room*",
      "/offer-center*",
      "/sales-ladder*",
      "/schema-index*",
      "/machine-index*",
      "/campaign-calendar*",
      "/accountability-review-inbox*",
      "/speculation-needs-review*",
      "/data/review-dashboard.json",
      "/data/site-brain-router.json",
      "/data/missing-record-queue.json",
      "/data/site-public-copy-intake-audit.json",
      "/data/card-deck-system-audit.json",
      "/downloads/review-dashboard.md",
      "/downloads/generated-site-repair-report.json",
      "/downloads/live-ai-management-verification.json",
      "/downloads/forum-posts*",
      "/downloads/the-black-file-matrix-reprogrammed.pdf",
      "/downloads/seven-day-intel.json",
      "/downloads/intel-vault.*",
      "/downloads/timer-synthesis.md",
      "/downloads/probability-snapshot.md",
      "/downloads/supporter*",
      "/downloads/weekly-*",
      "/downloads/signal-drop*",
      "/downloads/source-drop-bundle*",
      "/downloads/daily-*",
      "/downloads/intelligence-*",
      "/downloads/in-depth-report*",
      "/downloads/elite-report*",
      "/downloads/member-report*",
      "/downloads/research*",
      "/downloads/full-dossier*",
      "/downloads/citation*",
      "/downloads/bibliography*",
      "/downloads/evidence-path*",
      "/downloads/source-pack*",
      "/downloads/data-export*",
      "/downloads/network-export*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "FORUM_POSTS",
      "id": "99996d87016d4285a833707cbda5232f"
    }
  ],
  "d1_databases": [
    {
      "binding": "MEMBERS_DB",
      "database_name": "matrix-members",
      "database_id": "c6e465d3-4e36-4a00-b8f8-309447240c52"
    }
  ]
}
