{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrixreprogrammed.com/schemas/ai-management/compute-provider.schema.json",
  "title": "Matrix Reprogrammed Compute Provider Candidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "provider_id",
    "provider_name",
    "service_name",
    "access_method",
    "official_documentation_url",
    "terms_url",
    "privacy_url",
    "zero_spend_verified",
    "quota_verified",
    "billing_hard_stop_confirmed",
    "owner_onboarding_completed",
    "automation_permission_verified"
  ],
  "properties": {
    "provider_id": { "type": "string", "minLength": 3, "maxLength": 160 },
    "provider_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "service_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "access_method": { "enum": ["automatic_api", "manual_onboarding", "interactive_notebook", "prohibited"] },
    "endpoint_url": { "type": ["string", "null"], "format": "uri" },
    "official_documentation_url": { "type": "string", "format": "uri" },
    "terms_url": { "type": "string", "format": "uri" },
    "privacy_url": { "type": "string", "format": "uri" },
    "status_url": { "type": ["string", "null"], "format": "uri" },
    "account_required": { "type": "boolean" },
    "oauth_required": { "type": "boolean" },
    "phone_verification_required": { "type": "boolean" },
    "owner_onboarding_completed": { "type": "boolean" },
    "automation_permission_verified": { "type": "boolean" },
    "billing_hard_stop_confirmed": { "type": "boolean" },
    "payment_method_present": { "type": "boolean" },
    "zero_spend_verified": { "type": "boolean" },
    "quota_verified": { "type": "boolean" },
    "free_quota_amount": { "type": "number", "minimum": 0 },
    "free_quota_unit": { "type": ["string", "null"] },
    "quota_reset_period": { "type": ["string", "null"] },
    "session_max_minutes": { "type": "number", "minimum": 0 },
    "accelerator_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "minimum_gpu_memory_mb": { "type": "number", "minimum": 0 },
    "credential_reference": { "type": ["string", "null"], "description": "Secret binding name only; credential values are forbidden." },
    "terms_last_verified": { "type": ["string", "null"], "format": "date-time" },
    "terms_revalidation_due": { "type": ["string", "null"], "format": "date-time" },
    "quota_last_verified": { "type": ["string", "null"], "format": "date-time" },
    "manual_onboarding_steps": { "type": "array", "items": { "type": "string" } },
    "prohibited_uses": { "type": "array", "items": { "type": "string" } }
  }
}
