{
  "schema_version": 1,
  "mode": "level5-foundation",
  "objective": "Evolve Matrix Reprogrammed into a self-improving autonomous public-record intelligence system while preserving evidence, legal, privacy, zero-spend, deployment and owner-approval boundaries.",
