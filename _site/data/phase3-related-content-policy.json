{
  "version": "1.0.0",
  "status": "phase-3-report-only",
  "mode": "plan-only",
  "purpose": "Create deterministic, access-safe related-content links from canonical categories, controlled topics and same-subject labels without asserting real-world relationships or changing live navigation.",
  "exitCondition": "Every public or member-discoverable important item has relevant, access-compatible navigation links or an explicit orphan-review reason; no link leaks protected content or converts shared tags into a factual association.",
  "principles": [
    "Related-content links are navigation recommendations, not evidence of association, coordination, wrongdoing or control.",
    "Public pages may link only to public core, public preview or public commercial landing documents.",
    "Authenticated links are filtered by tier and never bypass locked-section decisions.",
    "Internal and restricted items never appear on public related-content surfaces.",
    "Graph and speculative items remain visibly labelled when recommended.",
    "Same-subject links mean the deterministic subject label matches; they do not establish that two different entities are connected.",
    "Existing page HTML, menus, indexes, routes and access controls remain unchanged during planning."
  ],
  "limits": {
    "publicLinksPerItem": 8,
    "authenticatedLinksPerTierPerItem": 12,
    "commercialLinksPerItem": 2,
    "minimumScore": 20,
    "minimumPublicLinksWhenCandidatesExist": 3,
    "minimumAuthenticatedLinksWhenCandidatesExist": 3,
    "maximumSameSubcategoryLinks": 3,
    "maximumSameContentTypeLinks": 4
  },
