  "version": "1.0.0",
  "status": "phase-3-report-only",
  "mode": "plan-only",
  "purpose": "Assign controlled topic, entity-type and navigation tags to every classified item without changing content, evidential status, routes or access controls.",
  "exitCondition": "Every important item has at least one controlled topic tag, an explicit entity-tag decision, provenance for every inferred tag and an association boundary preventing navigational metadata from being presented as proof.",
  "principles": [
    "A tag is navigation metadata, not evidence of wrongdoing, coordination, control or membership.",
    "Entity tags identify the subject or directory type of a page; they do not assert a relationship between tagged entities.",
    "Graph, scenario and speculative material retains its interpretive label in tag metadata.",
    "Public tags expose only public-safe metadata. Internal and restricted tags remain outside public indexes.",
    "Ambiguous entity extraction is retained as a review candidate rather than promoted to a factual association.",
    "Existing routes, content, search indexes and access controls remain unchanged during planning."
  ],
