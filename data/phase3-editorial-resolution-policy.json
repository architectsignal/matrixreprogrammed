{
  "version": "1.0.0",
  "status": "phase-3-report-only",
  "mode": "report-only",
  "purpose": "Resolve the remaining migration-review items into safe canonical categories, subcategories, tiers and editorial ownership without activating route, search or access changes.",
  "principles": [
    "High-confidence path families receive exact canonical categories.",
    "Generated build, audit, campaign and operational outputs default to internal review rather than public intelligence.",
    "Evidence-oriented records remain public unless a separate privacy or legal review restricts them.",
    "Ambiguous content receives a content-type category and an editorial review flag; it does not remain uncategorized.",
    "A resolved category is a migration recommendation, not proof that the current page is publication-ready.",
    "No route, content, search document or entitlement is changed by this resolver."
  ],
