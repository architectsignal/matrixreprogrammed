<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Membership | Matrix Reprogrammed</title>
  <meta name="description" content="Create a free Matrix Reprogrammed account or choose a verified monthly intelligence membership."/>
  <link rel="stylesheet" href="styles.css"/>
  <link rel="stylesheet" href="reader-experience.css"/>
  <style>
    .money-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1rem}
    .money-card{border:1px solid rgba(216,181,106,.28);border-radius:22px;padding:1rem;background:linear-gradient(150deg,rgba(14,8,2,.96),rgba(0,0,0,.95))}
    .price{font-size:2rem;color:#d8b56a;font-weight:900}.mini{font-size:.84rem;color:#c8b98c}
    .member-form{display:grid;gap:.8rem;max-width:720px}.member-form input{width:100%;box-sizing:border-box;background:#050505;color:#f3e6bd;border:1px solid rgba(216,181,106,.35);border-radius:12px;padding:.85rem}
    .consent-row{display:flex;gap:.65rem;align-items:flex-start}.consent-row input{width:auto;margin-top:.25rem}.status{min-height:1.4rem;font-weight:700}.status.ok{color:#9ddd9d}.status.error{color:#ff9b8f}.status.pending{color:#d8b56a}
    .account-actions{display:flex;gap:.7rem;flex-wrap:wrap}.paypal-zone{min-height:48px;margin-top:.8rem}.plan-state{font-size:.86rem;color:#c8b98c;min-height:2.5rem}.secure-note{border-left:3px solid #d8b56a;padding-left:.8rem}.tier-kicker{font-size:.78rem;text-transform:uppercase;letter-spacing:.09em;color:#c8b98c}
  </style>
</head>
<body>
<canvas id="matrix"></canvas>
<div class="page">
  <header class="wrap topbar">
    <a class="brand" href="index.html"><img src="sigil.png" alt="Matrix Reprogrammed sigil"/> MATRIX REPROGRAMMED</a>
    <nav class="nav"><a href="start-here.html">Start Here</a><a href="daily-command-brief.html">Daily Brief</a><a href="search.html">Search</a><a href="evidence-vault.html">Evidence</a><a href="membership.html">Membership</a><a href="books.html">Books</a></nav>
  </header>
  <main class="wrap section">
    <div class="eyebrow">Member Intelligence</div>
    <h1>CHOOSE HOW DEEPLY YOU WANT TO INVESTIGATE.</h1>
    <p class="lead">Create a free passwordless account, then upgrade only when you want deeper briefs, dossiers, evidence history, exports and research tools.</p>
    <p><strong>Evidence boundary:</strong> payment never changes the evidence standard. Public accusations must retain their source route, grade, limitation and correction path.</p>

    <section class="section money-card" id="free-member">
      <div class="tier-kicker">No card required</div>
      <h2>Free Member</h2><div class="price">€0</div>
      <p>Create a passwordless account and keep your personal Matrix Reprogrammed workspace.</p>
      <ul><li>free member dashboard</li><li>passwordless login and session controls</li><li>save public reports and cards</li><li>follow public topics</li><li>public weekly archive</li><li>newsletter and release preferences</li><li>public download history</li><li>verified-member Signal Board posting</li></ul>
      <form id="membership-signup" class="member-form" novalidate>
        <label>Display name <input id="member-name" name="name" type="text" maxlength="120" autocomplete="name" placeholder="Your name or public handle (optional)"/></label>
        <label>Email address <input id="member-email" name="email" type="email" maxlength="240" autocomplete="email" required placeholder="you@example.com"/></label>
        <label class="consent-row"><input id="member-consent" name="marketingConsent" type="checkbox" required/><span>I agree to receive the Matrix Reprogrammed member email and Daily Control Brief. I can unsubscribe at any time.</span></label>
        <button class="btn" type="submit">Create Free Member Account</button>
        <p id="signup-status" class="status" role="status" aria-live="polite"></p>
      </form>
      <div class="account-actions"><a class="btn" href="member-login.html">Already a member? Sign in</a><a class="btn alt" href="member-dashboard.html">Open member dashboard</a></div>
      <p class="mini"><strong>Billing boundary:</strong> Free Member access never creates a PayPal subscription and never requires payment details. Verification links expire after 15 minutes and can be used once.</p>
    </section>

    <section class="section">
      <h2>Monthly intelligence memberships</h2>
      <p id="paypal-system-status" class="status pending" role="status" aria-live="polite">Checking membership availability…</p>
      <p class="secure-note"><strong>Access rule:</strong> the browser cannot grant paid access. The backend verifies the PayPal Plan ID, checkout intent, subscription status and webhook state. Paid access begins only while PayPal reports <strong>ACTIVE</strong>.</p>
      <div class="money-grid">
        <article class="money-card" id="join-supporter">
          <div class="tier-kicker">Everything in Free Member</div><h3>Supporter</h3><div class="price">€3/month</div>
          <ul><li>weekly member intelligence brief</li><li>member newsletter and editorial notes</li><li>member-only public-source drops</li><li>selected supporter downloads</li><li>weekly brief archive</li><li>supporter announcements and surveys</li></ul>
          <div id="paypal-supporter" class="paypal-zone"></div><p id="paypal-supporter-status" class="plan-state">Sign in to activate this plan.</p>
        </article>
        <article class="money-card" id="join-intelligence-member">
          <div class="tier-kicker">Everything in Supporter and Free Member</div><h3>Intelligence Member</h3><div class="price">€6/month</div>
          <ul><li>premium daily intelligence brief</li><li>full card intelligence and evidence notes</li><li>deeper entity and institution dossiers</li><li>full relationship and source-ledger views</li><li>historical evidence-map views and advanced filters</li><li>missing-record queue</li><li>downloadable intelligence packs</li></ul>
          <div id="paypal-intelligence" class="paypal-zone"></div><p id="paypal-intelligence-status" class="plan-state">Sign in to activate this plan.</p>
        </article>
        <article class="money-card" id="join-research-pro">
          <div class="tier-kicker">Everything in Intelligence Member</div><h3>Research Pro</h3><div class="price">€9/month</div>
          <ul><li>full dossier and bulk evidence exports</li><li>research API access</li><li>private case boards and advanced watchlists</li><li>document text and metadata extraction</li><li>policy and jurisdiction trackers</li><li>priority source requests</li><li>professional monthly intelligence pack</li></ul>
          <div id="paypal-research-pro" class="paypal-zone"></div><p id="paypal-research-pro-status" class="plan-state">Sign in to activate this plan.</p>
        </article>
      </div>
    </section>
  </main>
  <footer class="footer wrap"><p><strong>Membership principle:</strong> public claims remain verifiable without payment. Membership funds preservation, alerts, history, exports and deeper investigation tools.</p></footer>
</div>
<script src="matrix.js"></script>
<script>
(() => {
  const signupForm = document.getElementById('membership-signup');
  const signupStatus = document.getElementById('signup-status');
  signupForm.addEventListener('submit', async event => {
    event.preventDefault();
    signupStatus.className = 'status pending';
    signupStatus.textContent = 'Creating your account…';
    const email = document.getElementById('member-email').value.trim();
    const name = document.getElementById('member-name').value.trim();
    const marketingConsent = document.getElementById('member-consent').checked;
    try {
      const response = await fetch('/api/membership/signup', {
        method: 'POST', headers: {'content-type':'application/json'},
        body: JSON.stringify({email,name,marketingConsent,consentVersion:'membership-consent-v1',source:'membership-page',sourcePage:'/membership.html'})
      });
      const data = await response.json();
      if (!response.ok || !data.saved) throw new Error(data.error || data.message || 'Account could not be created.');
      const emailSent = Boolean(data.emailSent || (data.verification && data.verification.sent));
      signupStatus.className = emailSent ? 'status ok' : 'status pending';
      signupStatus.textContent = emailSent ? 'Check your email for your verification link.' : 'Your account was saved. Verification delivery is queued and will retry when email delivery is available.';
      if (emailSent) signupForm.reset();
    } catch (error) {
      signupStatus.className = 'status error';
      signupStatus.textContent = error.message || 'Account could not be created.';
    }
  });

  const systemStatus = document.getElementById('paypal-system-status');
  const planUi = {
    supporter: {container:'#paypal-supporter', status:document.getElementById('paypal-supporter-status')},
    intelligence: {container:'#paypal-intelligence', status:document.getElementById('paypal-intelligence-status')},
    research_pro: {container:'#paypal-research-pro', status:document.getElementById('paypal-research-pro-status')}
  };
  const setAllPlanMessages = message => Object.values(planUi).forEach(item => { item.status.textContent = message; });
  const readJson = async response => { const text = await response.text(); try { return JSON.parse(text); } catch { throw new Error('The membership service returned an invalid response.'); } };
  const postJson = async (url, body) => {
    const response = await fetch(url, {method:'POST', headers:{'content-type':'application/json',accept:'application/json'}, body:JSON.stringify(body)});
    const data = await readJson(response);
    if (!response.ok || data.ok === false) throw new Error(data.error || data.message || 'The PayPal membership request failed.');
    return data;
  };
  const loadSdk = clientId => new Promise((resolve, reject) => {
    if (window.paypal) return resolve();
    const script = document.createElement('script');
    script.src = 'https://www.paypal.com/sdk/js?client-id=' + encodeURIComponent(clientId) + '&currency=EUR&vault=true&intent=subscription&components=buttons';
    script.async = true;
    script.onload = resolve;
    script.onerror = () => reject(new Error('The PayPal checkout library could not be loaded.'));
    document.head.appendChild(script);
  });
  const renderPlan = tier => {
    const ui = planUi[tier];
    let checkoutIntentId = '';
    ui.status.textContent = 'PayPal checkout ready.';
    window.paypal.Buttons({
      style:{shape:'rect',layout:'vertical',label:'subscribe',height:42},
      createSubscription: async (data, actions) => {
        ui.status.textContent = 'Creating a secure checkout intent…';
        const intent = await postJson('/api/paypal/checkout-intent', {tier});
        checkoutIntentId = intent.intentId;
        ui.status.textContent = 'Complete the approval in PayPal.';
        return actions.subscription.create({
          plan_id:intent.planId,
          custom_id:intent.intentId,
          application_context:{brand_name:'Matrix Reprogrammed',shipping_preference:'NO_SHIPPING',user_action:'SUBSCRIBE_NOW'}
        });
      },
      onApprove: async data => {
        ui.status.textContent = 'Verifying the PayPal subscription with the server…';
        try {
          const confirmed = await postJson('/api/paypal/subscription/confirm', {subscriptionId:data.subscriptionID,checkoutIntentId});
          ui.status.textContent = confirmed.paidAccess ? 'Membership active. Opening your dashboard…' : confirmed.message;
          ui.status.style.color = confirmed.paidAccess ? '#9ddd9d' : '#d8b56a';
          if (confirmed.paidAccess) setTimeout(() => { location.href='/member-dashboard.html?paypal=active'; }, 900);
        } catch (error) {
          ui.status.textContent = error.message;
          ui.status.style.color = '#ff9b8f';
        }
      },
      onCancel: () => { ui.status.textContent = 'PayPal checkout cancelled. No membership change was made.'; },
      onError: error => { ui.status.textContent = 'PayPal checkout error. ' + (error && error.message ? error.message : 'Please try again.'); ui.status.style.color='#ff9b8f'; }
    }).render(ui.container);
  };
  const initialisePayPal = async () => {
    try {
      const response = await fetch('/api/paypal/config', {headers:{accept:'application/json'},cache:'no-store'});
      const config = await readJson(response);
      if (response.status === 401) {
        systemStatus.className = 'status pending';
        systemStatus.innerHTML = 'Sign in before choosing a paid plan. <a href="member-login.html">Request a secure login link</a>.';
        setAllPlanMessages('Sign in to activate this plan.');
        return;
      }
      if (!response.ok || !config.configured || !config.clientId) {
        systemStatus.className = 'status pending';
        systemStatus.textContent = 'Paid memberships are being configured. Free Member access remains available.';
        setAllPlanMessages('Checkout is not configured. No payment can be taken.');
        return;
      }
      if (!config.checkoutEnabled) {
        systemStatus.className = 'status pending';
        systemStatus.textContent = 'PayPal is installed but checkout remains disabled behind the server activation gates. No payment can be taken.';
        setAllPlanMessages('Checkout disabled. Free Member access remains available.');
        return;
      }
      await loadSdk(config.clientId);
      systemStatus.className = 'status ok';
      systemStatus.textContent = 'Secure PayPal checkout is ready. Prices are billed monthly in EUR.';
      Object.keys(planUi).forEach(renderPlan);
    } catch (error) {
      systemStatus.className = 'status error';
      systemStatus.textContent = error.message || 'PayPal checkout could not be initialised.';
      setAllPlanMessages('Checkout unavailable. No membership change was made.');
    }
  };
  initialisePayPal();
})();
</script>
</body>
</html>
