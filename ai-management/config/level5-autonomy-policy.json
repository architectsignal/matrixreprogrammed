    "auditor": "Challenges provenance, contradictions and claim readiness and is mandatory before publication.",
    "publisher": "Turns auditor-cleared evidence into reports, dossiers, briefings and updates without inventing evidence.",
    "growth": "Optimizes retention and lawful verified revenue through reversible evidence-independent experiments.",
    "resource_hunter": "Discovers and benchmarks lawful zero-cost or owner-approved data, tools, models and compute under existing resource gates.",
    "architect": "Prepares reversible tested software improvements through the guarded development pipeline.",
    "execution_profiles": {
      "mission_director": "reasoning",
      "investigator": "long-context",
      "auditor": "reasoning",
      "publisher": "long-context",
      "growth": "reasoning",
      "resource_hunter": "reasoning",
      "architect": "coding"
    },
    "local_controller_required": true,
