const suitFiles=['data/heroes-fighting-matrix/keys.json','data/heroes-fighting-matrix/shields.json','data/heroes-fighting-matrix/torches.json','data/heroes-fighting-matrix/swords.json'];let cards=[];let active='ALL';const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));function render(){const q=document.getElementById('ledger-search').value.trim().toLowerCase();const visible=cards.filter(card=>(active==='ALL'||card.suit===active)&&(!q||[card.name,card.lane,card.contribution,card.whyIncluded,card.caveat,...card.sources.map(source=>source.label)].join(' ').toLowerCase().includes(q)));document.getElementById('ledger-count').textContent=`Showing ${visible.length} of ${cards.length} records.`;document.getElementById('ledger').className='';document.getElementById('ledger').innerHTML=visible.map(card=>`<article class="record"><div class="record-head"><div><div class="meta">#${card.rank} · ${esc(card.suit)} · Score ${card.score}/100 · Confidence ${esc(card.confidence)}</div><h2><a href="heroes-fighting-matrix-card.html?id=${encodeURIComponent(card.id)}">${esc(card.name)}</a></h2><p><strong>${esc(card.lane)}</strong></p></div><a class="btn" href="heroes-fighting-matrix-card.html?id=${encodeURIComponent(card.id)}">Open Dossier</a></div><p><strong>Documented contribution:</strong> ${esc(card.contribution)}</p><p><strong>Why included:</strong> ${esc(card.whyIncluded)}</p><p class="boundary"><strong>Boundary:</strong> ${esc(card.caveat)}</p><h3>Sources</h3><div class="source-grid">${card.sources.map(source=>`<div class="source"><span class="badge">${esc(source.type||'source')}</span><p><strong>${esc(source.label)}</strong></p><a h${'ref'}="${esc(source.url)}" rel="noopener noreferrer">Open source record</a></div>`).join('')}</div></article>`).join('')||'<div class="loading">No records match this search.</div>';}
Promise.all(suitFiles.map(url=>fetch(url).then(r=>{if(!r.ok)throw new Error(url);return r.json();}))).then(groups=>{cards=groups.flat().sort((a,b)=>a.rank-b.rank);render();}).catch(error=>{document.getElementById('ledger').innerHTML='<h2>Ledger unavailable</h2><p>The research files could not be loaded.</p>';console.error(error);});document.getElementById('ledger-search').addEventListener('input',render);document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{active=button.dataset.filter;document.querySelectorAll('[data-filter]').forEach(item=>item.classList.toggle('active',item===button));render();}));document.getElementById('download-ledger').addEventListener('click',()=>{if(!cards.length)return;const blob=new Blob([JSON.stringify({title:'Heroes Fighting the Matrix',boundary:'Documented public contribution is not total endorsement.',cards},null,2)],{type:'application/json'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download='heroes-fighting-matrix-source-ledger.json';link.click();URL.revokeObjectURL(link.href);});
