  "contentTypeOverrides": {
    "legal_or_trust_page": {
      "minimumTier": "public",
      "publicView": "full"
    },
    "source_record": {
      "minimumTier": "public",
      "publicView": "full"
    },
    "evidence_document": {
      "minimumTier": "public",
      "publicView": "full",
      "exception": "Restricted, victim-protection, privacy or legal-hold material follows restricted review."
    },
    "account_page": {
      "minimumTier": "registered",
      "publicView": "metadata_only",
      "exception": "Login, registration, confirmation and unsubscribe entry routes remain public entry surfaces."
    },
    "internal_report": {
      "minimumTier": null,
      "publicView": "access_denied"
    },
    "book_or_product": {
      "minimumTier": null,
      "publicView": "commercial_landing"
    },
    "historical_version": {
      "minimumTier": "public",
      "publicView": "metadata_only",
      "exception": "Correction, withdrawal and supersession notices remain public; underlying restricted data stays restricted."
    }
  },
  "interpretiveRules": {
    "research_hint": {
      "publicLabelRequired": "speculative research hint — association not proof",
      "factualStatusMutableByTier": false
    },
    "scenario_analysis": {
      "publicLabelRequired": "speculative scenario analysis — not a factual forecast",
      "factualStatusMutableByTier": false
    },
    "speculative": {
      "publicLabelRequired": "speculative — not established fact",
      "factualStatusMutableByTier": false
    },
    "disputed": {
      "publicLabelRequired": "disputed claim — not established fact",
      "factualStatusMutableByTier": false
    }
  },
  "separateProductRules": {
    "membershipDoesNotGrantPurchase": true,
    "publicLandingVisible": true,
    "purchasedFilesRequireProductEntitlement": true,
    "productEntitlementIsNotMembershipTier": true
  },
  "internalRules": {
    "membershipDoesNotGrantAccess": true,
    "requiresInternalRole": true,
    "mustNotLeakToSearchFeedsOrPublicBundles": true
  },
  "restrictedRules": {
    "membershipDoesNotGrantAccess": true,
    "requiresRestrictedReviewerRole": true,
    "mustNotLeakToSearchFeedsOrPublicBundles": true,
    "publicNoticeMayRemainWhenRequiredByLawTrustOrVictimProtection": true
  },
  "matrixInvariants": [
    "Tiers are cumulative in the declared order.",
    "Public safety sections are present on every public preview.",
    "Higher tiers never change claim class, record status, evidence grade, factual conclusion scope or interpretive label.",
    "Corrections, withdrawals, supersessions and material public counter-evidence remain public.",
    "Paid items have a public companion preview before locked-section enforcement.",
    "Internal and restricted content are not unlocked by membership.",
    "Separate-product entitlement is distinct from membership entitlement.",
    "No matrix row activates authentication, entitlement enforcement, email delivery or payment."
  ],
  "protectedBoundaries": {
    "lockedSectionEnforcement": false,
    "authenticationActivation": false,
    "entitlementActivation": false,
    "emailDeliveryActivation": false,
    "paymentActivation": false,
    "routeMovement": false,
    "searchRemoval": false,
    "contentMutation": false
  }
}
